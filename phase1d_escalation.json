{
  "name": "LifeLine - Phase 1d - Escalation",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "hours", "hoursInterval": 1 }] }
      },
      "id": "2a222222-0000-4000-8000-000000000001",
      "name": "Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-40, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://YOUR-PROJECT-REF.supabase.co/rest/v1/complaints?status=eq.open&select=*",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" }
          ]
        },
        "options": {}
      },
      "id": "2a222222-0000-4000-8000-000000000002",
      "name": "Get Open Complaints",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "jsCode": "const now = Date.now();\nconst out = [];\n\nfor (const item of $input.all()) {\n  const c = item.json;\n  const hoursOpen = (now - new Date(c.created_at).getTime()) / 3600000;\n  const isSafety = c.priority === 'safety_critical';\n\n  const reminderThreshold = isSafety ? 6 : 48;\n  const escalateThreshold = isSafety ? 12 : 96; // ~2x reminder threshold\n\n  const lastReminderHoursAgo = c.last_reminder_at\n    ? (now - new Date(c.last_reminder_at).getTime()) / 3600000\n    : Infinity;\n\n  if (hoursOpen >= escalateThreshold && !c.escalated) {\n    out.push({ json: { ...c, hoursOpen, action: 'escalate' } });\n  } else if (hoursOpen >= reminderThreshold && lastReminderHoursAgo >= reminderThreshold) {\n    out.push({ json: { ...c, hoursOpen, action: 'remind' } });\n  }\n}\n\nreturn out;"
      },
      "id": "2a222222-0000-4000-8000-000000000003",
      "name": "Find Stale Complaints",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-escalate",
              "leftValue": "={{ $json.action }}",
              "rightValue": "escalate",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "2a222222-0000-4000-8000-000000000004",
      "name": "Escalate or Remind?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $env.WHATSAPP_PHONE_NUMBER_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.WHATSAPP_ACCESS_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $env.WARDEN_WHATSAPP_NUMBER }}\",\n  \"type\": \"text\",\n  \"text\": { \"body\": \"\\u23F0 ESCALATION: {{ $json.location }} — {{ $json.category }} has been open {{ Math.floor($json.hoursOpen) }}h with no resolution.\\n{{ $json.description }}\\nAssigned to: {{ $json.assigned_to }}\" }\n}",
        "options": {}
      },
      "id": "2a222222-0000-4000-8000-000000000005",
      "name": "WhatsApp Warden - Escalate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $env.WHATSAPP_PHONE_NUMBER_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.WHATSAPP_ACCESS_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $env.MAINTENANCE_WHATSAPP_NUMBER }}\",\n  \"type\": \"text\",\n  \"text\": { \"body\": \"\\u23F0 REMINDER: {{ $json.location }} — {{ $json.category }} still open after {{ Math.floor($json.hoursOpen) }}h.\\n{{ $json.description }}\\nReply DONE-{{ $json.id }} once fixed.\" }\n}",
        "options": {}
      },
      "id": "2a222222-0000-4000-8000-000000000006",
      "name": "WhatsApp Maintenance - Remind",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 400]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://YOUR-PROJECT-REF.supabase.co/rest/v1/complaints?id=eq.{{ $json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"escalated\": true,\n  \"last_reminder_at\": \"{{ new Date().toISOString() }}\"\n}",
        "options": {}
      },
      "id": "2a222222-0000-4000-8000-000000000007",
