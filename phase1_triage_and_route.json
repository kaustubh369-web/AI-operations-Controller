{
  "name": "LifeLine - Phase 1b+1c - Triage & Route",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lifeline-new-complaint",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "1a111111-0000-4000-8000-000000000001",
      "name": "New Complaint (Supabase Webhook)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-40, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $env.ANTHROPIC_API_KEY }}" },
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-6\",\n  \"max_tokens\": 300,\n  \"system\": \"You triage hostel maintenance complaints. Reply with ONLY minified JSON, no prose, no markdown fences, shaped exactly like: {\\\"priority\\\":\\\"low|medium|high|safety_critical\\\",\\\"category\\\":\\\"Electrical|Plumbing|Civil-Structural|Furniture|Network|Other\\\",\\\"notes\\\":\\\"one short sentence explaining the priority\\\"}. safety_critical = risk of injury, fire, electrocution, structural collapse, gas, or flooding. high = affects many students or a core facility (no water, no power to a wing). medium = affects one room but is disruptive. low = cosmetic or minor.\",\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"Category submitted by student: {{ $json.body.record.category }}\\nLocation: {{ $json.body.record.location }}\\nDescription: {{ $json.body.record.description }}\\nHas photo: {{ $json.body.record.photo_url ? 'yes' : 'no' }}\" }\n  ]\n}",
        "options": {}
      },
      "id": "1a111111-0000-4000-8000-000000000002",
      "name": "Claude - AI Triage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "jsCode": "const complaint = $('New Complaint (Supabase Webhook)').first().json.body.record;\nconst claudeText = $input.first().json.content[0].text;\n\nlet triage;\ntry {\n  triage = JSON.parse(claudeText);\n} catch (e) {\n  triage = { priority: 'medium', category: complaint.category, notes: 'AI triage response could not be parsed — defaulted to medium.' };\n}\n\nconst routeMap = {\n  'Electrical': 'Electrician group',\n  'Plumbing': 'Plumber group',\n  'Civil-Structural': 'Civil maintenance group',\n  'Furniture': 'Carpenter group',\n  'Network': 'IT / Network admin',\n  'Other': 'General maintenance group'\n};\n\nreturn [{\n  json: {\n    id: complaint.id,\n    location: complaint.location,\n    description: complaint.description,\n    photo_url: complaint.photo_url,\n    category: triage.category || complaint.category,\n    priority: triage.priority || 'medium',\n    ai_notes: triage.notes || '',\n    assigned_to: routeMap[triage.category || complaint.category] || 'General maintenance group'\n  }\n}];"
      },
      "id": "1a111111-0000-4000-8000-000000000003",
      "name": "Parse Triage Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://YOUR-PROJECT-REF.supabase.co/rest/v1/complaints?id=eq.{{ $json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"priority\": \"{{ $json.priority }}\",\n  \"category\": \"{{ $json.category }}\",\n  \"ai_notes\": \"{{ $json.ai_notes }}\",\n  \"assigned_to\": \"{{ $json.assigned_to }}\"\n}",
        "options": {}
      },
      "id": "1a111111-0000-4000-8000-000000000004",
      "name": "Update Complaint in Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $env.WHATSAPP_PHONE_NUMBER_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.WHATSAPP_ACCESS_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $env.MAINTENANCE_WHATSAPP_NUMBER }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"\\uD83D\\uDEA8 [{{ $json.priority }}] {{ $json.category }} — {{ $json.location }}\\n\\n{{ $json.description }}\\n\\nAI note: {{ $json.ai_notes }}\\nRouted to: {{ $json.assigned_to }}\\nPhoto: {{ $json.photo_url || 'none' }}\\n\\nReply DONE-{{ $json.id }} once fixed.\"\n  }\n}",
        "options": {}
      },
      "id": "1a111111-0000-4000-8000-000000000005",
      "name": "Send WhatsApp to Maintenance",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 220]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-safety",
              "leftValue": "={{ $json.priority }}",
              "rightValue": "safety_critical",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1a111111-0000-4000-8000-000000000006",
      "name": "Is Safety Critical?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [920, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $env.WHATSAPP_PHONE_NUMBER_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.WHATSAPP_ACCESS_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $env.WARDEN_WHATSAPP_NUMBER }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"\\u26A0\\uFE0F SAFETY-CRITICAL report at {{ $json.location }}: {{ $json.description }}\\nImmediate attention needed — already routed to {{ $json.assigned_to }}.\"\n  }\n}",
        "options": {}
      },
      "id": "1a111111-0000-4000-8000-000000000007",
      "name": "Immediately Notify Warden",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1160, 400]
    }
  ],
  "connections": {
    "New Complaint (Supabase Webhook)": { "main": [[{ "node": "Claude - AI Triage", "type": "main", "index": 0 }]] },
    "Claude - AI Triage": { "main": [[{ "node": "Parse Triage Result", "type": "main", "index": 0 }]] },
    "Parse Triage Result": { "main": [[{ "node": "Update Complaint in Supabase", "type": "main", "index": 0 }]] },
    "Update Complaint in Supabase": { "main": [[{ "node": "Send WhatsApp to Maintenance", "type": "main", "index": 0 }, { "node": "Is Safety Critical?", "type": "main", "index": 0 }]] },
    "Is Safety Critical?": { "main": [[{ "node": "Immediately Notify Warden", "type": "main", "index": 0 }], []] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
